{
  "expo": {
    "name": "Cinemans",
    "slug": "cinemans-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/icon.png",
    "scheme": "cinemans",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cinemans.mobile"
    },
    "android": {
      "package": "com.cinemans.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/adaptive-foreground.png",
        "backgroundColor": "#090B10"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/branding/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/branding/splash.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "backgroundColor": "#090B10"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ccfc6bdd-1a69-4490-a682-731036ea38af"
      }
    }
  }
}
